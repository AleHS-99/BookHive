{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-download-read",
    "fs:allow-download-write",
    "os:default",
    "os:allow-platform"
  ]
}